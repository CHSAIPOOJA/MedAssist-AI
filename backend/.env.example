# Copy this file to .env and fill in your own values.

PORT=4000

# Any long random string — used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string

# Free API key from https://aistudio.google.com/apikey (no credit card needed
# for the free-tier models). Required for AI report summaries and the report
# chatbot — everything else in the app works without it.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Embedding model used for semantic search (RAG). The defaults are fine.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# Email medicine reminders (optional). Easiest: run "npm run setup:email".
# Needs a Gmail account with 2-Step Verification + an App Password
# (https://myaccount.google.com/apppasswords). Never use your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
